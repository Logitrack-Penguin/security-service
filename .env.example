# Copiar a .env (que NO se sube a Git) y completar. Para generar JWT_SECRET: openssl rand -base64 32
DB_URL=jdbc:mysql://localhost:3306/security_service?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USER=root
DB_PASSWORD=cambiar
JWT_SECRET=cambiar_por_un_base64_de_al_menos_32_bytes
# Opcional: crea un ADMIN inicial al arrancar si todavia no existe
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambiar_password_largo
ADMIN_EMAIL=admin@logitrack.local
